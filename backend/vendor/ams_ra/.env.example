# ── LLM Provider ─────────────────────────────────────────────
# Default: nvidia (Nemotron)
# Options: nvidia | anthropic | openai
LLM_PROVIDER=nvidia

# ── NVIDIA Nemotron (default) ─────────────────────────────────
# Get your free API key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# Model options:
# nvidia/llama-3.1-nemotron-70b-instruct  (default — best quality)
# nvidia/llama-3.1-nemotron-51b-instruct  (faster)
# meta/llama-3.1-405b-instruct            (largest)
# meta/llama-3.1-70b-instruct             (lightweight)
LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ── Anthropic (alternative) ───────────────────────────────────
# Uncomment and set LLM_PROVIDER=anthropic to use
# ANTHROPIC_API_KEY=your_anthropic_key_here

# ── OpenAI (alternative) ──────────────────────────────────────
# Uncomment and set LLM_PROVIDER=openai to use
# OPENAI_API_KEY=your_openai_key_here

# ── Timeouts ──────────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
